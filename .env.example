# Copy to .env (or run `make env` to generate one with random secrets).

POSTGRES_PASSWORD=change-me
# RabbitMQ users (stored hashed in the broker's definitions)
RABBITMQ_MIDLAYER_PASSWORD=change-me
RABBITMQ_RUNNER_PASSWORD=change-me
# Bearer token for /api/v1/admin/*. Empty disables the admin API.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Published ports. The webapp is the public entry point; oj-rest is only
# published on loopback (for curl / the smoke test).
WEB_PORT=8080
REST_PORT=127.0.0.1:8000
# URL users open (SvelteKit's CSRF check compares form posts against it; baked in at build).
PUBLIC_ORIGIN=http://localhost:8080

# Capacity: total judging concurrency = RUNNER_REPLICAS x RUNNER_WORKERS
RUNNER_REPLICAS=2
RUNNER_WORKERS=2
RUNNER_MEM_LIMIT=2g
RUNNER_CPUS=2
MAX_QUEUE_DEPTH=1000
RUN_TIMEOUT_S=30

# Edge
CORS_ORIGINS=*
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_BURST=5
