# Copy to .env (or run `make env` to generate one with random secrets).

POSTGRES_PASSWORD=change-me
# Bearer token for /api/v1/admin/*. Empty disables the admin API.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Published ports
WEB_PORT=8080
REST_PORT=127.0.0.1:8000

# Capacity
RUNNER_WORKERS=2
RUNNER_MEM_LIMIT=2g
RUNNER_CPUS=2
JUDGE_WORKERS=4

# Edge
CORS_ORIGINS=*
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_BURST=5
